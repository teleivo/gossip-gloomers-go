# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/co

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# maelstrom generated
store/

# built binaries
maelstrom-echo/maelstrom-echo
maelstrom-unique-ids/maelstrom-unique-ids
maelstrom-broadcast-3a/maelstrom-broadcast
maelstrom-broadcast-3b/maelstrom-broadcast
maelstrom-broadcast-3c/maelstrom-broadcast
maelstrom-broadcast-3d-grid/maelstrom-broadcast
maelstrom-broadcast-3d-tree/maelstrom-broadcast
maelstrom-counter/maelstrom-counter
maelstrom-kafka-5a/maelstrom-kafka
maelstrom-kafka-5b/maelstrom-kafka

# debugging/testing
_research/
*.log
scratch*.dot
.claude/
maelstrom-broadcast-3d/trees/

*.pprof
